# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / SvelteKit / Vite
node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tests/e2e/__screenshots__/

# Packaging artifact drop (SPA copied here at package time, never checked in)
server/factory_console/_static/

# Intermediate OpenAPI schema `make codegen` writes for openapi-typescript to read.
# Derived from the models on every run; types.ts is the checked-in output.
frontend/.openapi.json

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
.env
.env.*
*.pem
*.key
.factory/
# Fixture run-state markers are test data and MUST be tracked (overrides .factory/ above)
!tests/fixtures/projects/**/.factory/
!tests/fixtures/projects/**/.factory/**
.claude/settings.json
