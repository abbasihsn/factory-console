{
	"name": "factory-console-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"e2e": "playwright test",
		"screenshots": "playwright test --grep screenshots && node scripts/copy-screenshots.mjs",
		"codegen": "openapi-typescript ${FC_OPENAPI_URL:-http://127.0.0.1:8000/api/v1/openapi.json} -o src/lib/api/types.ts --immutable && node scripts/postcodegen.mjs",
		"lint": "eslint . --ext .js,.cjs,.ts,.svelte",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/lang-markdown": "^6.3.2",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.36.4",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/svelte": "^5.2.6",
		"@types/cytoscape-dagre": "^2.3.3",
		"@types/dagre": "^0.7.52",
		"@typescript-eslint/eslint-plugin": "^8.19.0",
		"@typescript-eslint/parser": "^8.19.0",
		"autoprefixer": "^10.4.20",
		"codemirror": "^6.0.1",
		"cytoscape": "^3.30.4",
		"cytoscape-dagre": "^2.5.0",
		"dagre": "^0.8.5",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"jsdom": "^25.0.1",
		"openapi-typescript": "^7.5.2",
		"postcss": "^8.4.49",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.20.0",
		"svelte-check": "^4.1.1",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",
		"vite": "^6.0.7",
		"vitest": "^3.2.4"
	}
}
